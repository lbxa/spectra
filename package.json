{
  "name": "spectra",
  "private": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build:workers": "bun build extension/src/background.ts --outfile dist/background.js --target browser --format iife && bunx tsc -p tsconfig.content.json",
    "popup:build": "bunx vite build --config vite.popup.config.ts",
    "popup:dev": "bunx vite build --config vite.popup.config.ts --watch",
    "popup:hmr": "bunx vite --config vite.popup.config.ts --open /popup.dev.html",
    "build": "bun run clean && bun run build:workers && bun run popup:build",
    "typecheck": "bunx tsc -p tsconfig.background.json --noEmit && bunx tsc -p tsconfig.content.json --noEmit && bunx tsc -p tsconfig.popup.json --noEmit",
    "dev": "bun run build && bun run typecheck"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-scroll-area": "latest",
    "@radix-ui/react-slot": "latest",
    "@xyflow/react": "^12.10.1",
    "class-variance-authority": "latest",
    "clsx": "latest",
    "lucide-react": "^1.7.0",
    "react": "latest",
    "react-dom": "latest",
    "tailwind-merge": "latest",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@rolldown/plugin-babel": "latest",
    "@tailwindcss/vite": "latest",
    "@types/chrome": "^0.1.38",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "latest",
    "babel-plugin-react-compiler": "latest",
    "chrome-types": "latest",
    "shadcn": "^4.1.0",
    "tailwindcss": "latest",
    "typescript": "latest",
    "vite": "latest"
  }
}
