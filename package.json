  "bugs": {
    "url": "https://github.com/lbxa/spectra/issues"
  },
  "homepage": "https://github.com/lbxa/spectra#readme",
  "devDependencies": {
    "@turbo/gen": "^2.9.3",
    "@types/node": "^25.5.0",
    "turbo": "^2.9.3"
  }
}
