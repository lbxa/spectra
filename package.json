    "release": "bun run --filter './apps/spectra-chrome-extension' release",
    "release:dry-run": "bun run --filter './apps/spectra-chrome-extension' release:dry-run"
  },
  "packageManager": "bun@1.3.3",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lbxa/spectra.git"
  },
  "keywords": [],
  "author": "",
