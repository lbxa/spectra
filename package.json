{
  "name": "spectra",
  "private": true,
  "version": "1.0.0",
  "description": "",
  "workspaces": [
    "apps/*",
    "libs/*",
    "tooling/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "check": "turbo run check",
    "test": "turbo run test",
