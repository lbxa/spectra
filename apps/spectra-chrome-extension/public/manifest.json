{
  "manifest_version": 3,
  "name": "Spectra",
  "version": "1.0.0",
  "description": "Capture visible UI elements as reusable HTML and screenshot references.",
  "icons": {
    "16": "icons/orb.png",
    "32": "icons/orb.png",
    "48": "icons/orb.png",
    "128": "icons/orb.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Spectra",
    "default_icon": {
      "16": "icons/orb.png",
      "32": "icons/orb.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],
  "host_permissions": ["http://127.0.0.1/*", "http://localhost/*"],
  "web_accessible_resources": [
    {
      "resources": ["audio/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
